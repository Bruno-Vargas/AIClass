        lines.append("┌──────────────────────┬──────────┬──────────┬────────────┐")
        lines.append("│ Responsável          │ Ganhadas │ Perdidas │ Conversão  │")
        lines.append("├──────────────────────┼──────────┼──────────┼────────────┤")

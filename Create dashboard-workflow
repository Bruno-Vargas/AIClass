        lines.append("└────────────────────────┴────────────┴──────────┘")
        lines.append("")

        # Análise Qualitativa
        lines.append("💡 ANÁLISE QUALITATIVA E INSIGHTS")
        lines.append("-" * 80)
        lines.append("")


def main():
    """Função principal."""
    print("\n" + "=" * 80)
    print("WORKFLOW AUTOMATIZADO - RELATÓRIO DE FUNIL DE VENDAS KAVAK")
    print("=" * 80 + "\n")

    # Inicializa processador
    processor = DataProcessor()

    # Encontra data mais recente
    date_str = processor.find_latest_input_date()
    if not date_str:
        processor.add_log("Encerrando: nenhum dado para processar", "ERROR")
        return False

    # Processa dados
    if not processor.process(date_str):
        processor.add_log("Encerrando: falha no processamento", "ERROR")
        return False

    # Calcula métricas
    calculator = MetricsCalculator(processor)
    calculator.calculate_all()

    # Cria diretório de saída
    output_folder = OUTPUT_DIR / date_str
    output_folder.mkdir(parents=True, exist_ok=True)

    # Gera relatórios
    processor.add_log("[ETAPA 5] GERAÇÃO DE RELATÓRIOS")

    generator = ReportGenerator(processor, calculator, date_str)

    # TXT
    txt_content = generator.generate_txt()
    txt_file = output_folder / REPORT_TXT_TEMPLATE.format(date=date_str)
    txt_file.write_text(txt_content, encoding='utf-8')
    processor.add_log(f"✓ Relatório TXT gerado: {txt_file.name}")

    # HTML
    html_content = generator.generate_html()
    html_file = output_folder / REPORT_HTML_TEMPLATE.format(date=date_str)
    html_file.write_text(html_content, encoding='utf-8')
    processor.add_log(f"✓ Relatório HTML gerado: {html_file.name}")

    # JSON
    json_file = output_folder / METRICS_JSON_TEMPLATE
    json_file.write_text(json.dumps(calculator.metrics, indent=2, ensure_ascii=False), encoding='utf-8')
    processor.add_log(f"✓ Métricas JSON geradas: {json_file.name}")

    # Logs
    log_file = output_folder / LOG_FILE_TEMPLATE
    LogWriter.write(log_file, processor.logs)
    processor.add_log(f"✓ Log salvo: {log_file.name}")

    # Resumo final
    processor.add_log("")
    processor.add_log("=" * 80)
    processor.add_log("✓ SUCESSO - Processamento concluído")
    processor.add_log("=" * 80)

    print("\n" + "=" * 80)
    print(f"✓ RELATÓRIOS GERADOS EM: {output_folder}")
    print("=" * 80 + "\n")

    return True


if __name__ == "__main__":
    success = main()
    sys.exit(0 if success else 1)

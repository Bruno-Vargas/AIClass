class LogWriter:
    """Escreve logs estruturados."""

    @staticmethod
    def write(filepath: Path, logs: List[str]):
        """Escreve arquivo de log."""
        content = []
        content.append("=" * 80)
        content.append("LOG DE PROCESSAMENTO".center(80))
        content.append(f"Iniciado: {datetime.now().strftime('%d/%m/%Y %H:%M:%S')}".center(80))
        content.append("=" * 80)
        content.append("")

        for log in logs:
            content.append(log)

        content.append("")
        content.append("=" * 80)
        content.append(f"Finalizado: {datetime.now().strftime('%d/%m/%Y %H:%M:%S')}".center(80))
        content.append("=" * 80)

        filepath.write_text("\n".join(content), encoding='utf-8')



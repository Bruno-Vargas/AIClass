class DataProcessor:
    """Processa dados de oportunidades e visitas."""

    def __init__(self):
        self.opportunities = []
        self.events = []
        self.consolidated = {}
        self.logs = []
        self.errors = []

    def add_log(self, message: str, level: str = "INFO"):
        """Adiciona mensagem de log."""
        timestamp = datetime.now().strftime("%d/%m/%Y %H:%M:%S")
        log_msg = f"[{timestamp}] [{level}] {message}"
        self.logs.append(log_msg)
        if level == "ERROR":
            self.errors.append(message)
        print(log_msg)

    def find_latest_input_date(self) -> str:
        """Encontra a pasta mais recente em INPUT."""
        if not INPUT_DIR.exists():
            self.add_log(f"Diretório INPUT não existe: {INPUT_DIR}", "ERROR")
            return None

        folders = [d for d in INPUT_DIR.iterdir() if d.is_dir()]
        if not folders:
            self.add_log("Nenhuma pasta encontrada em INPUT", "WARNING")
            return None

        # Ordena por nome (formato DD-MM-AAAA)
        folders.sort(reverse=True)
        latest = folders[0].name
        self.add_log(f"Data mais recente encontrada: {latest}")
        return latest

    def load_csv(self, filepath: Path) -> List[Dict]:
        """Carrega arquivo CSV."""
        data = []
        if not filepath.exists():
            self.add_log(f"Arquivo não encontrado: {filepath}", "WARNING")
            return data

        try:
            with open(filepath, 'r', encoding='utf-8') as f:
                reader = csv.DictReader(f)
                for row in reader:
                    if row:  # Ignora linhas vazias
                        data.append(row)
            self.add_log(f"✓ Carregado: {filepath.name} ({len(data)} registros)")
        except Exception as e:
            self.add_log(f"Erro ao carregar {filepath}: {str(e)}", "ERROR")

        return data

    def validate_and_clean(self, data: List[Dict], data_type: str) -> List[Dict]:
        """Valida e limpa dados."""
        cleaned = []
        duplicates = 0
        empty_fields = 0

        seen = set()

        for row in data:
            # Determina campo chave
            key_field = "id" if data_type == "opportunities" else "WhatId"

            # Remove duplicatas
            key = row.get(key_field, "").strip()
            if not key or key in seen:
                duplicates += 1
                continue

            # Remove linhas com campos essenciais vazios
            if data_type == "opportunities":
                if not row.get("id") or not row.get("StageName"):
                    empty_fields += 1
                    continue
            else:  # events
                if not row.get("WhatId") or not row.get("Status"):
                    empty_fields += 1
                    continue

            seen.add(key)
            cleaned.append(row)

        self.add_log(
            f"Validação {data_type}: {len(cleaned)} válidos, "
            f"{duplicates} duplicatas, {empty_fields} campos vazios"
        )
        return cleaned

    def process(self, date_str: str) -> bool:
        """Processa dados do dia especificado."""
        self.add_log("=" * 80)
        self.add_log(f"INICIANDO PROCESSAMENTO - {date_str}")
        self.add_log("=" * 80)

        # Diretório de entrada
        input_folder = INPUT_DIR / date_str
        oppts_file = input_folder / "oppts.csv"
        events_file = input_folder / "events.csv"

        # Carrega dados
        self.add_log("[ETAPA 1] CARREGAMENTO DE ARQUIVOS")
        raw_oppts = self.load_csv(oppts_file)
        raw_events = self.load_csv(events_file)

        if not raw_oppts and not raw_events:
            self.add_log("Nenhum dado para processar", "WARNING")
            return False

        # Valida e limpa
        self.add_log("[ETAPA 2] VALIDAÇÃO E LIMPEZA")
        self.opportunities = self.validate_and_clean(raw_oppts, "opportunities")
        self.events = self.validate_and_clean(raw_events, "events")

        # Consolida dados
        self.add_log("[ETAPA 3] CONSOLIDAÇÃO DE DADOS")
        self.consolidate()

        return True

    def consolidate(self):
        """Consolida oportunidades com eventos."""
        for oppt in self.opportunities:
            oppt_id = oppt.get("id", "").strip()
            self.consolidated[oppt_id] = {
                "opportunity": oppt,
                "events": []
            }

        # Agrupa eventos por oportunidade
        for event in self.events:
            what_id = event.get("WhatId", "").strip()
            if what_id in self.consolidated:
                self.consolidated[what_id]["events"].append(event)

        coverage = len([c for c in self.consolidated.values() if c["events"]]) / len(self.consolidated) * 100 if self.consolidated else 0
        self.add_log(f"Consolidação completa: {len(self.consolidated)} oppts, {len(self.events)} eventos ({coverage:.1f}% cobertura)")


class MetricsCalculator:
    """Calcula métricas de vendas."""

    def __init__(self, processor: DataProcessor):
        self.processor = processor
        self.metrics = {}

    def calculate_all(self) -> Dict:
        """Calcula todas as métricas."""
        self.processor.add_log("[ETAPA 4] CÁLCULO DE MÉTRICAS")

        # Métricas gerais
        total_oppts = len(self.processor.consolidated)
        total_events = len(self.processor.events)
        total_confirmed = sum(1 for e in self.processor.events if e.get("Status") == "Confirmed")
        avg_visits = total_events / total_oppts if total_oppts > 0 else 0

        # Taxa de conversão geral
        won = sum(1 for o in self.processor.opportunities if o.get("StageName") == "Ganhada")
        general_conversion = (won / total_oppts * 100) if total_oppts > 0 else 0

        self.metrics["general"] = {
            "total_opportunities": total_oppts,
            "total_visits": total_events,
            "total_confirmed_visits": total_confirmed,
            "avg_visits_per_oppt": round(avg_visits, 2),
            "general_conversion_rate": round(general_conversion, 2)
        }

        # Por responsável
        self.metrics["by_owner"] = self._metrics_by_owner()

        # Por tipo de operação
        self.metrics["by_type"] = self._metrics_by_type()

        # Por fonte
        self.metrics["by_source"] = self._metrics_by_source()

        self.processor.add_log(f"✓ Métricas calculadas: {len(self.metrics)} categorias")
        return self.metrics

    def _metrics_by_owner(self) -> Dict:
        """Calcula métricas por responsável."""
        by_owner = defaultdict(lambda: {"oppts": 0, "visits": 0, "confirmed_visits": 0, "won": 0, "lost": 0})

        for oppt_id, data in self.processor.consolidated.items():
            oppt = data["opportunity"]
            owner = oppt.get("OwnerId", "Sem Atribuição").strip() or "Sem Atribuição"

            by_owner[owner]["oppts"] += 1
            by_owner[owner]["visits"] += len(data["events"])
            by_owner[owner]["confirmed_visits"] += sum(1 for e in data["events"] if e.get("Status") == "Confirmed")

            stage = oppt.get("StageName", "").strip()
            if stage == "Ganhada":
                by_owner[owner]["won"] += 1
            elif stage == "Cerrada Perdida":
                by_owner[owner]["lost"] += 1

        # Calcula taxas
        for owner in by_owner:
            total = by_owner[owner]["oppts"]
            won = by_owner[owner]["won"]
            by_owner[owner]["conversion_rate"] = (won / total * 100) if total > 0 else 0

        return dict(by_owner)

    def _metrics_by_type(self) -> Dict:
        """Calcula métricas por tipo de operação."""
        by_type = defaultdict(lambda: {"oppts": 0, "won": 0, "lost": 0, "visits": 0})

        for oppt_id, data in self.processor.consolidated.items():
            oppt = data["opportunity"]
            oppt_type = oppt.get("RecordType.Name", "Desconhecido").strip() or "Desconhecido"

            by_type[oppt_type]["oppts"] += 1
            by_type[oppt_type]["visits"] += len(data["events"])

            stage = oppt.get("StageName", "").strip()
            if stage == "Ganhada":
                by_type[oppt_type]["won"] += 1
            elif stage == "Cerrada Perdida":
                by_type[oppt_type]["lost"] += 1

        # Calcula taxas
        for oppt_type in by_type:
            total = by_type[oppt_type]["oppts"]
            won = by_type[oppt_type]["won"]
            by_type[oppt_type]["conversion_rate"] = (won / total * 100) if total > 0 else 0

        return dict(by_type)

    def _metrics_by_source(self) -> Dict:
        """Calcula métricas por fonte."""
        by_source = defaultdict(lambda: {"oppts": 0, "won": 0})

        for oppt_id, data in self.processor.consolidated.items():
            oppt = data["opportunity"]
            source = oppt.get("Source__c", "Desconhecido").strip() or "Desconhecido"

            by_source[source]["oppts"] += 1

            stage = oppt.get("StageName", "").strip()
            if stage == "Ganhada":
                by_source[source]["won"] += 1

        # Calcula taxas
        for source in by_source:
            total = by_source[source]["oppts"]
            won = by_source[source]["won"]
            by_source[source]["conversion_rate"] = (won / total * 100) if total > 0 else 0

        return dict(by_source)

    def get_top_performers(self, limit: int = 3) -> List[Tuple]:
        """Retorna top 3 vendedores por conversão."""
        by_owner = self.metrics.get("by_owner", {})
        sorted_owners = sorted(
            by_owner.items(),
            key=lambda x: (x[1]["conversion_rate"], x[1]["oppts"]),
            reverse=True
        )
        return sorted_owners[:limit]


